# OpenAlex asks for an email to put you in the fast "polite pool". Free, no key.
OPENALEX_MAILTO=you@trooly.io

# Optional: SERP vendor for recruitment-ad discovery (Serper.dev)
SERPAPI_KEY=your_serper_api_key_here
PORT=3000
